{
  "name": "astro-gov-starter",
  "type": "module",
  "version": "2.0.0",
  "description": "Production-ready Astro starter for government service websites. USWDS-native, accessible by default, privacy-respecting.",
  "keywords": [
    "astro",
    "uswds",
    "government",
    "accessibility",
    "508",
    "wcag"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/setup-uswds.mjs && astro dev",
    "build": "node scripts/setup-uswds.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "setup": "node scripts/setup-uswds.mjs",
    "ci:check": "bash scripts/check.sh",
    "init-agency": "node scripts/init-agency.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@uswds/uswds": "^3.14.0",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "html-validate": "^11.9.0",
    "linkinator": "^8.0.4",
    "pagefind": "^1.5.2",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
