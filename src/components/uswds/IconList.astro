---
/**
 * Icon list — usa-icon-list
 * https://designsystem.digital.gov/components/icon-list/
 *
 * Uses the USWDS sprite sheet at /uswds/img/sprite.svg (copied by
 * scripts/setup-uswds.mjs), so `icon` must name a symbol that exists there —
 * see node_modules/@uswds/uswds/dist/img/sprite.svg for the full set.
 */

interface IconListItem {
  /** USWDS icon sprite name, e.g. 'check_circle', 'cancel', 'info'. */
  icon: string;
  /** USWDS color utility, e.g. 'green', 'red', 'primary'. */
  color?: string;
  content: string;
}

interface Props {
  items: IconListItem[];
  /** 'size-md' | 'size-lg' etc — see USWDS docs for the full set. */
  size?: string;
  class?: string;
}

const { items, size, class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul
  class:list={[
    'usa-icon-list',
    size && `usa-icon-list--${size}`,
    className,
  ]}
>
  {items.map((item) => (
    <li class="usa-icon-list__item">
      <div class:list={['usa-icon-list__icon', item.color && `text-${item.color}`]}>
        <svg class="usa-icon" aria-hidden="true" role="img">
          <use href={`${base}uswds/img/sprite.svg#${item.icon}`}></use>
        </svg>
      </div>
      <div class="usa-icon-list__content">{item.content}</div>
    </li>
  ))}
</ul>
