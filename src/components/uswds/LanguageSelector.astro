---
/**
 * Language selector — usa-language-selector
 * https://designsystem.digital.gov/components/language-selector/
 *
 * Renders USWDS's "two languages" link variant when the site serves exactly
 * two locales, or the "three or more" dropdown variant otherwise (the
 * dropdown's open/close behavior comes from uswds.min.js, already loaded in
 * BaseLayout — no extra script needed here).
 *
 * Locales are read from `locales`/`localeMeta` in src/i18n/utils.ts, so
 * adding a language there updates this component automatically — see
 * "Adding a new language" in README.md.
 */
import type { Locale } from '../../i18n/utils';
import { locales, localeMeta, localizeUrl, stripLocaleFromPath } from '../../i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
  /** Extra classes on the outer .usa-language-container, e.g. responsive display utilities. */
  class?: string;
  /** Unique id for the dropdown submenu — pass distinct values if rendering multiple instances on one page. */
  submenuId?: string;
}

const { locale, currentPath, class: className, submenuId = 'language-options' } = Astro.props;
const barePath = stripLocaleFromPath(currentPath);

const alternates = locales
  .filter((code) => code !== locale)
  .map((code) => ({
    code,
    label: localeMeta[code].label,
    href: localizeUrl(barePath, code),
  }));

const isTwoLanguage = locales.length <= 2;
const alternate = alternates[0];
---

{isTwoLanguage && alternate ? (
  <div class:list={['usa-language-container', className]}>
    <a class="usa-button" href={alternate.href} lang={alternate.code} hreflang={alternate.code}>
      <span lang={alternate.code}>{alternate.label}</span>
    </a>
  </div>
) : (
  <div class:list={['usa-language-container', 'usa-language--small', className]}>
    <ul class="usa-language__primary usa-accordion">
      <li class="usa-language__primary-item">
        <button
          type="button"
          class="usa-button usa-language__link"
          aria-expanded="false"
          aria-controls={submenuId}
        >
          {localeMeta[locale].label}
        </button>
        <ul id={submenuId} class="usa-language__submenu" hidden>
          {alternates.map((alt) => (
            <li class="usa-language__submenu-item">
              <a href={alt.href} lang={alt.code} hreflang={alt.code}>
                <span lang={alt.code}>{alt.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </div>
)}
