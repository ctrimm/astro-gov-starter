---
/**
 * Table — usa-table
 * https://designsystem.digital.gov/components/table/
 *
 * Accessible data table. Pass `stacked` to reflow into label/value pairs
 * below the mobile-lg breakpoint instead of horizontally scrolling.
 */

interface Props {
  caption?: string;
  /** Column headers, in order. */
  columns: string[];
  /** Row data, in the same column order as `columns`. */
  rows: (string | number)[][];
  /** Render the first cell of each row as a <th scope="row"> instead of <td>. */
  rowHeader?: boolean;
  /** Reflow to stacked label/value rows below the mobile-lg breakpoint. */
  stacked?: boolean;
  borderless?: boolean;
  striped?: boolean;
  class?: string;
}

const {
  caption,
  columns,
  rows,
  rowHeader = true,
  stacked = false,
  borderless = false,
  striped = false,
  class: className,
} = Astro.props;
---

<table
  class:list={[
    'usa-table',
    stacked && 'usa-table--stacked',
    borderless && 'usa-table--borderless',
    striped && 'usa-table--striped',
    className,
  ]}
>
  {caption && <caption>{caption}</caption>}
  <thead>
    <tr>
      {columns.map((col) => (
        <th scope="col">{col}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        {row.map((cell, i) =>
          i === 0 && rowHeader ? (
            <th data-label={columns[i]} scope="row">{cell}</th>
          ) : (
            <td data-label={columns[i]}>{cell}</td>
          )
        )}
      </tr>
    ))}
  </tbody>
</table>
