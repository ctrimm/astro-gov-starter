---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/uswds/Breadcrumb.astro';
import { siteConfig } from '../../config/site';
import type { Locale } from '../../i18n/utils';
import { localeStaticPaths, withBase } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = locale === 'es' ? '/es' : '';

const copy = {
  en: {
    title: 'About',
    description: `About ${siteConfig.name} — our mission, programs, and how to reach us.`,
    breadcrumbs: [
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' },
    ],
    heading: `About ${siteConfig.name}`,
    intro: "Replace this placeholder with a description of your agency's mission and programs.",
    missionHeading: 'Our mission',
    mission: '[Agency Name] provides assistance programs and services to eligible residents, helping families meet their basic needs and achieve self-sufficiency.',
    programsHeading: 'Our programs',
    programs: 'We administer federal and state benefit programs including food assistance, health coverage, childcare support, and nutrition services.',
    programsLink: 'View all available programs',
    contactHeading: 'Contact us',
    contactLink: 'Reach our office',
    contactBody: 'by phone, email, or in person. We are here to help.',
  },
  es: {
    title: 'Acerca de',
    description: `Acerca de ${siteConfig.name} — nuestra misión, programas y cómo contactarnos.`,
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Acerca de', href: '/es/about/' },
    ],
    heading: `Acerca de ${siteConfig.name}`,
    intro: 'Reemplace este contenido provisional con una descripción de la misión y los programas de su agencia.',
    missionHeading: 'Nuestra misión',
    mission: '[Nombre de la Agencia] ofrece programas de asistencia y servicios a residentes elegibles, ayudando a las familias a satisfacer sus necesidades básicas y lograr la autosuficiencia.',
    programsHeading: 'Nuestros programas',
    programs: 'Administramos programas de beneficios federales y estatales, incluyendo asistencia alimentaria, cobertura de salud, apoyo para el cuidado infantil y servicios de nutrición.',
    programsLink: 'Ver todos los programas disponibles',
    contactHeading: 'Contáctenos',
    contactLink: 'Comuníquese con nuestra oficina',
    contactBody: 'por teléfono, correo electrónico o en persona. Estamos aquí para ayudarle.',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <div class="grid-container usa-section">
    <div class="grid-row">
      <div class="grid-col-12 tablet:grid-col-8">
        <Breadcrumb items={copy.breadcrumbs} />

        <h1>{copy.heading}</h1>

        <div class="usa-prose">
          <p class="usa-intro">{copy.intro}</p>

          <h2>{copy.missionHeading}</h2>
          <p>
            <!-- TODO: Replace with your agency's mission statement -->
            {copy.mission}
          </p>

          <h2>{copy.programsHeading}</h2>
          <p>
            {copy.programs}{' '}
            <a href={withBase(`${prefix}/services/`)} class="usa-link">{copy.programsLink}</a>.
          </p>

          <h2>{copy.contactHeading}</h2>
          <p>
            <a href={withBase(`${prefix}/contact/`)} class="usa-link">{copy.contactLink}</a>{' '}
            {copy.contactBody}
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
