---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/uswds/Hero.astro';
import ServiceCard from '../../../components/uswds/ServiceCard.astro';
import type { Locale } from '../../../i18n/utils';
import { localeStaticPaths, useTranslations, withBase } from '../../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'es' ? '/es' : '';

const copy = {
  en: {
    title: 'Apply',
    description: 'Start an application for a program you may qualify for.',
    heroHeading: 'Apply for benefits',
    heroSubheading: 'Choose a program to start your application. Each one takes about 20 minutes.',
    heroLabel: 'Apply',
    showing: (n: number) => `${n} programs accept applications online`,
    start: 'Start application',
    beforeHeading: 'Before you start',
    beforeIntro: 'Have these ready. It will make your application faster.',
    beforeItems: [
      'A photo ID for each adult in your home',
      'Proof of income for the last 30 days',
      'Your rent or mortgage amount',
    ],
    otherHeading: 'Other ways to apply',
    otherIntro: 'You do not have to apply online. You can also:',
    otherPhone: 'Call us at',
    otherPhoneNote: 'Monday to Friday, 8 a.m. to 8 p.m.',
    otherContactBefore: 'Visit an office near you or send us a message through our',
    otherContactLink: 'contact page',
    unsureLead: 'Not sure which program fits?',
    unsureBefore: 'Compare all of our',
    unsureLink: 'programs and services',
    unsureAfter: 'first.',
  },
  es: {
    title: 'Solicitar',
    description: 'Inicie una solicitud para un programa para el que puede calificar.',
    heroHeading: 'Solicitar beneficios',
    heroSubheading: 'Elija un programa para iniciar su solicitud. Cada una toma unos 20 minutos.',
    heroLabel: 'Solicitar',
    showing: (n: number) => `${n} programas aceptan solicitudes en línea`,
    start: 'Iniciar solicitud',
    beforeHeading: 'Antes de empezar',
    beforeIntro: 'Tenga esto a la mano. Hará su solicitud más rápida.',
    beforeItems: [
      'Una identificación con foto de cada adulto en su hogar',
      'Prueba de ingresos de los últimos 30 días',
      'El monto de su renta o hipoteca',
    ],
    otherHeading: 'Otras formas de solicitar',
    otherIntro: 'No tiene que solicitar en línea. También puede:',
    otherPhone: 'Llámenos al',
    otherPhoneNote: 'De lunes a viernes, 8 a.m. a 8 p.m.',
    otherContactBefore: 'Visite una oficina cerca de usted o envíenos un mensaje por nuestra',
    otherContactLink: 'página de contacto',
    unsureLead: '¿No sabe cuál programa le sirve?',
    unsureBefore: 'Compare todos nuestros',
    unsureLink: 'programas y servicios',
    unsureAfter: 'primero.',
  },
}[locale];

// Only programs with an apply flow belong here — the same filter
// /apply/[program]/ uses to decide which pages exist.
const services = (await getCollection('services', ({ data }) => !data.draft && !!data.applySlug))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <Hero
    heading={copy.heroHeading}
    subheading={copy.heroSubheading}
    label={copy.heroLabel}
    small
  />

  <div class="grid-container usa-section">
    <p class="text-base font-sans-sm">{copy.showing(services.length)}</p>

    <ul class="usa-card-group">
      {services.map((service) => (
        <ServiceCard
          title={service.data.title}
          summary={service.data.summary}
          href={`${prefix}/apply/${service.data.applySlug}/`}
          ctaText={copy.start}
          acceptingApplications={service.data.acceptingApplications}
          locale={locale}
          class="tablet:grid-col-6 desktop:grid-col-4"
        />
      ))}
    </ul>

    <div class="usa-prose margin-top-6">
      <h2>{copy.beforeHeading}</h2>
      <p>{copy.beforeIntro}</p>
      <ul class="usa-list">
        {copy.beforeItems.map((item) => <li>{item}</li>)}
      </ul>

      <h2>{copy.otherHeading}</h2>
      <p>{copy.otherIntro}</p>
      <ul class="usa-list">
        <li>
          {copy.otherPhone}{' '}
          <a href="tel:18005550100" class="usa-link">1&#8209;800&#8209;555&#8209;0100</a>.{' '}
          {copy.otherPhoneNote}
        </li>
        <li>
          {copy.otherContactBefore}{' '}
          <a href={withBase(`${prefix}/contact/`)} class="usa-link">{copy.otherContactLink}</a>.
        </li>
      </ul>

      <p>
        <strong>{copy.unsureLead}</strong> {copy.unsureBefore}{' '}
        <a href={withBase(`${prefix}/services/`)} class="usa-link">{copy.unsureLink}</a>{' '}
        {copy.unsureAfter}
      </p>
    </div>
  </div>
</BaseLayout>
