---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SummaryBox from '../../components/uswds/SummaryBox.astro';
import type { Locale } from '../../i18n/utils';
import { localeStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Per-locale ids keep the two rendered pages' anchors distinct.
const idSuffix = locale === 'es' ? '-es' : '';

const copy = {
  en: {
    title: 'Contact us',
    description: "Reach our office by phone, email, or in person. We're here to help.",
    heading: 'Contact us',
    intro: "We're here to help. Reach us by phone, online form, or visit one of our offices.",
    formHeading: 'Send a message',
    formLabel: 'Contact form',
    required: 'required',
    name: 'Full name',
    email: 'Email address',
    emailHint: "We'll use this to respond to your message.",
    phone: 'Phone number',
    optional: '(optional)',
    topicLegend: 'What is your question about?',
    topics: ['SNAP Benefits', 'Medicaid', 'WIC', 'Child Care Assistance', 'My application status', 'Other'],
    message: 'Message',
    messageHint: 'Do not include your Social Security number or case number in your message.',
    submit: 'Send message',
    sidebarHeading: 'Other ways to reach us',
    phoneHeading: 'Phone',
    hours: 'Monday–Friday, 8 a.m.–8 p.m. ET',
    inPersonHeading: 'In person',
    inPersonLink: 'Find an office near you',
    inPersonNote: 'No appointment needed for most services.',
    mailHeading: 'Mail',
    responseHeading: 'Response time',
    responseBody: 'We respond to messages within 2 business days.',
  },
  es: {
    title: 'Contáctenos',
    description: 'Comuníquese con nuestra oficina por teléfono, correo electrónico o en persona.',
    heading: 'Contáctenos',
    intro: 'Estamos aquí para ayudar. Comuníquese con nosotros por teléfono, formulario en línea o visítenos en persona.',
    formHeading: 'Enviar un mensaje',
    formLabel: 'Formulario de contacto',
    required: 'requerido',
    name: 'Nombre completo',
    email: 'Correo electrónico',
    emailHint: 'Lo usaremos para responder a su mensaje.',
    phone: 'Número de teléfono',
    optional: '(opcional)',
    topicLegend: '¿Su pregunta es sobre?',
    topics: ['Beneficios SNAP', 'Medicaid', 'WIC', 'Asistencia para cuidado infantil', 'Estado de mi solicitud', 'Otro'],
    message: 'Mensaje',
    messageHint: 'No incluya su número de Seguro Social ni número de caso en su mensaje.',
    submit: 'Enviar mensaje',
    sidebarHeading: 'Otras formas de contactarnos',
    phoneHeading: 'Teléfono',
    hours: 'Lunes a viernes, 8 a.m.–8 p.m. ET',
    inPersonHeading: 'En persona',
    inPersonLink: 'Encuentre una oficina cerca de usted',
    inPersonNote: 'No se necesita cita para la mayoría de los servicios.',
    mailHeading: 'Correo postal',
    responseHeading: 'Tiempo de respuesta',
    responseBody: 'Respondemos a los mensajes en 2 días hábiles.',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <div class="grid-container usa-section">
    <h1>{copy.heading}</h1>
    <p class="usa-intro">{copy.intro}</p>

    <div class="grid-row grid-gap">
      <!-- Contact form -->
      <div class="grid-col-12 tablet:grid-col-7">
        <h2>{copy.formHeading}</h2>

        <!--
          FORM SCAFFOLD: Accessible structure with ARIA and proper label/error patterns.
          Submission handler is a TODO stub — see PRD §3 and CONTRIBUTING.md for options
          (Formspree, API Gateway + Lambda, etc.)
        -->
        <form
          class="usa-form usa-form--large"
          method="post"
          action="#"
          aria-label={copy.formLabel}
          novalidate
          lang={locale === 'es' ? 'es' : undefined}
        >
          <p class="usa-hint">{t('a11y.requiredFields')}.</p>

          <div class="usa-form-group">
            <label class="usa-label" for={`contact-name${idSuffix}`}>
              {copy.name} <abbr title={copy.required}>*</abbr>
            </label>
            <input
              class="usa-input"
              id={`contact-name${idSuffix}`}
              name="name"
              type="text"
              autocomplete="name"
              required
              aria-required="true"
            />
          </div>

          <div class="usa-form-group">
            <label class="usa-label" for={`contact-email${idSuffix}`}>
              {copy.email} <abbr title={copy.required}>*</abbr>
            </label>
            <span class="usa-hint" id={`contact-email-hint${idSuffix}`}>
              {copy.emailHint}
            </span>
            <input
              class="usa-input"
              id={`contact-email${idSuffix}`}
              name="email"
              type="email"
              autocomplete="email"
              required
              aria-required="true"
              aria-describedby={`contact-email-hint${idSuffix}`}
            />
          </div>

          <div class="usa-form-group">
            <label class="usa-label" for={`contact-phone${idSuffix}`}>
              {copy.phone} <span class="usa-hint">{copy.optional}</span>
            </label>
            <input
              class="usa-input"
              id={`contact-phone${idSuffix}`}
              name="phone"
              type="tel"
              autocomplete="tel"
            />
          </div>

          <fieldset class="usa-fieldset">
            <legend class="usa-legend">
              {copy.topicLegend} <abbr title={copy.required}>*</abbr>
            </legend>
            {copy.topics.map((topic) => (
              <div class="usa-radio">
                <input
                  class="usa-radio__input"
                  id={`topic${idSuffix}-${topic.replace(/\s+/g, '-').toLowerCase()}`}
                  type="radio"
                  name="topic"
                  value={topic}
                  required
                />
                <label
                  class="usa-radio__label"
                  for={`topic${idSuffix}-${topic.replace(/\s+/g, '-').toLowerCase()}`}
                >
                  {topic}
                </label>
              </div>
            ))}
          </fieldset>

          <div class="usa-form-group">
            <label class="usa-label" for={`contact-message${idSuffix}`}>
              {copy.message} <abbr title={copy.required}>*</abbr>
            </label>
            <span class="usa-hint" id={`contact-message-hint${idSuffix}`}>
              {copy.messageHint}
            </span>
            <textarea
              class="usa-textarea"
              id={`contact-message${idSuffix}`}
              name="message"
              rows={6}
              required
              aria-required="true"
              aria-describedby={`contact-message-hint${idSuffix}`}
            ></textarea>
          </div>

          <button type="submit" class="usa-button usa-button--big">
            {copy.submit}
            <!-- TODO (M3): Wire up to Formspree, API Gateway, or agency backend -->
          </button>
        </form>
      </div>

      <!-- Contact details sidebar -->
      <div class="grid-col-12 tablet:grid-col-5">
        <SummaryBox heading={copy.sidebarHeading} label={copy.sidebarHeading}>
          <h3 class="font-heading-sm margin-bottom-0">{copy.phoneHeading}</h3>
          <p>
            <a href="tel:18005550100" class="usa-link">1&#8209;800&#8209;555&#8209;0100</a>
            <br />
            TTY: <a href="tel:18005550101" class="usa-link">1&#8209;800&#8209;555&#8209;0101</a>
            <br />
            <span class="text-base-dark font-sans-sm">{copy.hours}</span>
          </p>

          <h3 class="font-heading-sm margin-bottom-0">{copy.inPersonHeading}</h3>
          <p>
            <a href="https://www.google.com/maps" class="usa-link" rel="noreferrer">
              {copy.inPersonLink}
            </a>
            <br />
            <span class="text-base-dark font-sans-sm">{copy.inPersonNote}</span>
          </p>

          <h3 class="font-heading-sm margin-bottom-0">{copy.mailHeading}</h3>
          <address class="usa-prose">
            Agency Name<br />
            123 Main Street, Suite 100<br />
            City, ST 00000
          </address>

          <h3 class="font-heading-sm margin-bottom-0">{copy.responseHeading}</h3>
          <p>{copy.responseBody}</p>
        </SummaryBox>
      </div>
    </div>
  </div>
</BaseLayout>
