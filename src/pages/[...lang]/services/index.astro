---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/uswds/Hero.astro';
import ServiceCard from '../../../components/uswds/ServiceCard.astro';
import { idToSlug } from '../../../utils/content';
import type { Locale } from '../../../i18n/utils';
import { localeStaticPaths, useTranslations, withBase } from '../../../i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'es' ? '/es' : '';

const copy = {
  en: {
    title: 'Services',
    description: 'Find programs and services you may be eligible for.',
    heroHeading: 'Programs & services',
    heroSubheading: 'We offer assistance programs for eligible residents. Select a program to learn more and start your application.',
    heroLabel: 'Services',
    showing: (n: number) => `Showing ${n} programs`,
    notFoundLead: "Don't see what you need?",
    notFoundHelp: 'help center',
    notFoundOr: 'or',
    notFoundContact: 'contact us',
    benefitsBefore: 'You can also visit',
    benefitsAfter: 'to find additional federal programs.',
    benefitsUrl: 'https://www.benefits.gov/',
  },
  es: {
    title: 'Programas y servicios',
    description: 'Encuentre los programas para los que puede ser elegible.',
    heroHeading: 'Programas y servicios',
    heroSubheading: 'Ofrecemos programas de asistencia para residentes elegibles. Seleccione un programa para obtener más información e iniciar su solicitud.',
    heroLabel: 'Servicios',
    showing: (n: number) => `Mostrando ${n} programas`,
    notFoundLead: '¿No encuentra lo que necesita?',
    notFoundHelp: 'centro de ayuda',
    notFoundOr: 'o',
    notFoundContact: 'contáctenos',
    benefitsBefore: 'También puede visitar',
    benefitsAfter: 'para encontrar programas federales adicionales.',
    benefitsUrl: 'https://www.benefits.gov/es',
  },
}[locale];

const services = (await getCollection('services', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <Hero
    heading={copy.heroHeading}
    subheading={copy.heroSubheading}
    label={copy.heroLabel}
    small
  />

  <div class="grid-container usa-section">
    <p class="text-base font-sans-sm">{copy.showing(services.length)}</p>

    <ul class="usa-card-group">
      {services.map((service) => (
        <ServiceCard
          title={service.data.title}
          summary={service.data.summary}
          href={`${prefix}/services/${idToSlug(service.id)}/`}
          ctaText={t('home.learnMore')}
          acceptingApplications={service.data.acceptingApplications}
          locale={locale}
          class="tablet:grid-col-6 desktop:grid-col-4"
        />
      ))}
    </ul>

    <div class="usa-prose margin-top-6">
      <p>
        <strong>{copy.notFoundLead}</strong> {locale === 'es' ? 'Visite nuestro' : 'Visit our'}{' '}
        <a href={withBase(`${prefix}/help/`)} class="usa-link">{copy.notFoundHelp}</a> {copy.notFoundOr}{' '}
        <a href={withBase(`${prefix}/contact/`)} class="usa-link">{copy.notFoundContact}</a>.
      </p>
      <p>
        {copy.benefitsBefore}{' '}
        <a href={copy.benefitsUrl} class="usa-link" rel="noreferrer">Benefits.gov</a>{' '}
        {copy.benefitsAfter}
      </p>
    </div>
  </div>
</BaseLayout>
