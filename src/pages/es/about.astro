---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/uswds/Breadcrumb.astro';
import { siteConfig } from '../../config/site';
import { withBase } from '../../i18n/utils';

const locale = 'es';
---

<BaseLayout
  title="Acerca de"
  description={`Acerca de ${siteConfig.name} — nuestra misión, programas y cómo contactarnos.`}
  locale={locale}
>
  <div class="grid-container usa-section">
    <div class="grid-row">
      <div class="grid-col-12 tablet:grid-col-8">
        <Breadcrumb items={[
          { label: 'Inicio', href: '/es/' },
          { label: 'Acerca de', href: '/es/about/' },
        ]} />

        <h1>Acerca de {siteConfig.name}</h1>

        <div class="usa-prose">
          <p class="usa-intro">
            Reemplace este contenido provisional con una descripción de la misión y los
            programas de su agencia.
          </p>

          <h2>Nuestra misión</h2>
          <p>
            <!-- TODO: Reemplace con la declaración de misión de su agencia -->
            [Nombre de la Agencia] ofrece programas de asistencia y servicios a residentes
            elegibles, ayudando a las familias a satisfacer sus necesidades básicas y lograr
            la autosuficiencia.
          </p>

          <h2>Nuestros programas</h2>
          <p>
            Administramos programas de beneficios federales y estatales, incluyendo asistencia
            alimentaria, cobertura de salud, apoyo para el cuidado infantil y servicios de
            nutrición.
            <a href={withBase('/es/services/')} class="usa-link">Ver todos los programas disponibles</a>.
          </p>

          <h2>Contáctenos</h2>
          <p>
            <a href={withBase('/es/contact/')} class="usa-link">Comuníquese con nuestra oficina</a>{' '}
            por teléfono, correo electrónico o en persona. Estamos aquí para ayudarle.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
