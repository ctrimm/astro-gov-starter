---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SummaryBox from '../../components/uswds/SummaryBox.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);
---

<BaseLayout
  title="Contáctenos"
  description="Comuníquese con nuestra oficina por teléfono, correo electrónico o en persona."
  locale={locale}
>
  <div class="grid-container usa-section">
    <h1>Contáctenos</h1>
    <p class="usa-intro">
      Estamos aquí para ayudar. Comuníquese con nosotros por teléfono, formulario en línea
      o visítenos en persona.
    </p>

    <div class="grid-row grid-gap">
      <div class="grid-col-12 tablet:grid-col-7">
        <h2>Enviar un mensaje</h2>

        <!--
          FORM SCAFFOLD: Accessible structure with ARIA and proper label/error patterns.
          Submission handler is a TODO stub — see PRD §3 and CONTRIBUTING.md for options
          (Formspree, API Gateway + Lambda, etc.)
        -->
        <form
          class="usa-form usa-form--large"
          method="post"
          action="#"
          aria-label="Formulario de contacto"
          novalidate
          lang="es"
        >
          <p class="usa-hint">{t('a11y.requiredFields')}.</p>

          <div class="usa-form-group">
            <label class="usa-label" for="contact-name-es">
              Nombre completo <abbr title="requerido">*</abbr>
            </label>
            <input class="usa-input" id="contact-name-es" name="name" type="text" autocomplete="name" required aria-required="true" />
          </div>

          <div class="usa-form-group">
            <label class="usa-label" for="contact-email-es">
              Correo electrónico <abbr title="requerido">*</abbr>
            </label>
            <span class="usa-hint" id="contact-email-hint-es">
              Lo usaremos para responder a su mensaje.
            </span>
            <input class="usa-input" id="contact-email-es" name="email" type="email" autocomplete="email" required aria-required="true" aria-describedby="contact-email-hint-es" />
          </div>

          <div class="usa-form-group">
            <label class="usa-label" for="contact-phone-es">
              Número de teléfono <span class="usa-hint">(opcional)</span>
            </label>
            <input class="usa-input" id="contact-phone-es" name="phone" type="tel" autocomplete="tel" />
          </div>

          <fieldset class="usa-fieldset">
            <legend class="usa-legend">
              ¿Su pregunta es sobre? <abbr title="requerido">*</abbr>
            </legend>
            {['Beneficios SNAP', 'Medicaid', 'WIC', 'Asistencia para cuidado infantil', 'Estado de mi solicitud', 'Otro'].map((topic) => (
              <div class="usa-radio">
                <input
                  class="usa-radio__input"
                  id={`topic-es-${topic.replace(/\s+/g, '-').toLowerCase()}`}
                  type="radio"
                  name="topic"
                  value={topic}
                  required
                />
                <label class="usa-radio__label" for={`topic-es-${topic.replace(/\s+/g, '-').toLowerCase()}`}>
                  {topic}
                </label>
              </div>
            ))}
          </fieldset>

          <div class="usa-form-group">
            <label class="usa-label" for="contact-message-es">
              Mensaje <abbr title="requerido">*</abbr>
            </label>
            <span class="usa-hint" id="contact-message-hint-es">
              No incluya su número de Seguro Social ni número de caso en su mensaje.
            </span>
            <textarea class="usa-textarea" id="contact-message-es" name="message" rows={6} required aria-required="true" aria-describedby="contact-message-hint-es"></textarea>
          </div>

          <button type="submit" class="usa-button usa-button--big">
            Enviar mensaje
            <!-- TODO (M3): Wire up to Formspree, API Gateway, or agency backend -->
          </button>
        </form>
      </div>

      <div class="grid-col-12 tablet:grid-col-5">
        <SummaryBox heading="Otras formas de contactarnos" label="Otras formas de contactarnos">
          <h3 class="font-heading-sm margin-bottom-0">Teléfono</h3>
          <p>
            <a href="tel:18005550100" class="usa-link">1&#8209;800&#8209;555&#8209;0100</a><br />
            TTY: <a href="tel:18005550101" class="usa-link">1&#8209;800&#8209;555&#8209;0101</a><br />
            <span class="text-base-dark font-sans-sm">Lunes a viernes, 8 a.m.–8 p.m. ET</span>
          </p>

          <h3 class="font-heading-sm margin-bottom-0">En persona</h3>
          <p>
            <a href="https://www.google.com/maps" class="usa-link" rel="noreferrer">
              Encuentre una oficina cerca de usted
            </a>
            <br />
            <span class="text-base-dark font-sans-sm">No se necesita cita para la mayoría de los servicios.</span>
          </p>

          <h3 class="font-heading-sm margin-bottom-0">Correo postal</h3>
          <address class="usa-prose">
            Agency Name<br />
            123 Main Street, Suite 100<br />
            City, ST 00000
          </address>

          <h3 class="font-heading-sm margin-bottom-0">Tiempo de respuesta</h3>
          <p>Respondemos a los mensajes en 2 días hábiles.</p>
        </SummaryBox>
      </div>
    </div>
  </div>
</BaseLayout>
